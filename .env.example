# StudyAssist AI - Environment Variables
# ==========================================
# Copy this file to .env and fill in your API keys
# Command: cp .env.example .env

# ─── Flask Settings ───────────────────────────────────────────────────────────
# Change this to a random secret string in production!
SECRET_KEY=mysecretkey

# ─── Groq API (FREE tier available) ──────────────────────────────────────────
# Sign up at: https://console.groq.com
# Free tier: 14,400 requests/day with fast Llama3 model
GROQ_API_KEY=your_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── IBM Watson Text-to-Speech ────────────────────────────────────────────────
# Sign up at: https://cloud.ibm.com (free tier available)
# Create a Text to Speech service instance
# Copy API key and URL from your service credentials
IBM_API_KEY=KQGmrsTgRBa98vWMfJJY5qU7HZ3kNJLIJMTz4mIHI2MY
IBM_URL=https://api.au-syd.text-to-speech.watson.cloud.ibm.com/instances/be3bd205-595f-4025-a5a0-fd1ce9a0526a

# ─── Google Gemini (OPTIONAL - backup LLM) ────────────────────────────────────
# Sign up at: https://makersuite.google.com/app/apikey
# Free tier available
GEMINI_API_KEY=AIzaSyCy5_DaMdBX5sBUFwLbqvh4jsXZcFmhEYs

# ─── Notes ───────────────────────────────────────────────────────────────────
# - GROQ_API_KEY is required for Q&A, summarization, and question generation
# - IBM_API_KEY and IBM_URL are required for text-to-speech (optional feature)
# - Without API keys, the app will run but AI features won't work
# - The embedding model (sentence-transformers) runs locally - no API key needed
